MCP_BRIDGE_HOST=0.0.0.0
MCP_BRIDGE_PORT=8008
BLENDER_ADDON_HOST=127.0.0.1
BLENDER_ADDON_PORT=8888

# Optional: Directory for resolving relative texture, HDRI, or 3D Printing export paths.
# BLENDER_ASSETS_DIR=/path/to/your/assets

# Optional: API keys for Studio's AI Assistant panel. A provider only appears as
# "configured" in the panel if one of its keys is set here (a key pasted into the
# panel at runtime overrides these). Not needed for n8n or plain MCP use.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
